{
  "name": "world-memory-ledger",
  "version": "0.0.1",
  "type": "module",
  "description": "把几份记忆折进系统前缀，并给 bot 一套写记忆、找旧事的工具；到期与余量在卡尾报出，超限只提醒、不截断。",
  "author": "xiaofentai",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofentai/jingxi-coopanion-worlds.git",
    "directory": "packages/memory-ledger"
  },
  "homepage": "https://github.com/xiaofentai/jingxi-coopanion-worlds/tree/main/packages/memory-ledger",
  "bugs": {
    "url": "https://github.com/xiaofentai/jingxi-coopanion-worlds/issues"
  },
  "keywords": [
    "cortico-world",
    "world",
    "memory",
    "prefix",
    "prompt"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Memory Graph",
    "tags": [
      "memory"
    ],
    "locales": {
      "zh": {
        "displayName": "记忆树网",
        "description": "把要它记住的那几份折成「一行一块」的图谱，交接前先放在眼前；末尾报出哪几天在窗口外、哪一份条目超了，但一个块都不丢。另给八个工具，让她自己写、自己压、自己搬。不调用模型，不联网。"
      }
    }
  },
  "files": [
    "src",
    "ENV_PROMPT.md",
    "ENV_PROMPT.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/parse.test.ts tests/board.test.ts tests/write.test.ts tests/tools.test.ts tests/archive.test.ts tests/recall.test.ts tests/text.test.ts tests/recent.test.ts tests/prime.test.ts tests/audit.test.ts tests/route.test.ts",
    "dump": "node scripts/dump.ts",
    "check": "node scripts/check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
